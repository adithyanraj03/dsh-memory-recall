{
  "name": "dsh-memory-recall",
  "version": "0.2.1",
  "description": "Persistent memory for dsh in the style of Hermes Agent: a memory tool that keeps a user profile and the model's own notes, delivered to every chat as a logged context message — at the start, after a change and after compaction — and a session_search tool that reads earlier chats only after the user approves, with a Memory panel to see and edit what is kept.",
  "type": "module",
  "main": "./src/index.js",
  "exports": {
    ".": "./src/index.js",
    "./client": "./lib/client.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "files": [
    "src",
    "lib",
    "cordis.patch.yml",
    "package.json",
    "README.md",
    "LICENSE",
    "dsh.plugin.json",
    "screenshots.json"
  ],
  "scripts": {
    "test": "node --test \"test/*.test.js\""
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-ui-conversation",
        "@deepseek-ai/dsh-client-ui-sidebar"
      ]
    }
  },
  "keywords": [
    "dsh-plugin",
    "dsh",
    "deepseek-harness",
    "memory",
    "recall",
    "session-search",
    "hermes"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/adithyanraj03/dsh-memory-recall.git"
  },
  "homepage": "https://adithyanraj03.github.io/dsh-memory-recall/",
  "bugs": {
    "url": "https://github.com/adithyanraj03/dsh-memory-recall/issues"
  },
  "author": "Adithya N Raj (adithyanraj03)",
  "license": "MIT",
  "engines": {
    "node": ">=22"
  }
}
